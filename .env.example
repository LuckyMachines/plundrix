# Foundry deploy
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0x...
ANVIL_RPC_URL=http://127.0.0.1:18645 # set to your active anvil port when non-default
# Local app env is written automatically by `npm run deploy:local`

# Etherscan verification (optional)
ETHERSCAN_API_KEY=

# Added from live Coolify environment inventory. Values are placeholders only.
# Apps: plundrix-game-staging [EU]
NIXPACKS_NODE_VERSION=22
NODE_ENV=development
NOINDEX=false
PORT=3000
RAILWAY_SERVICE_PLUNDRIX_MARKETING_URL=https://example.com
RAILWAY_SERVICE_PLUNDRIX_SPA_URL=https://example.com
VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=https://example.com
