# Foundry deploy
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0x...
ANVIL_RPC_URL=http://127.0.0.1:18645 # set to your active anvil port when non-default
# Local app env is written automatically by `npm run deploy:local`

# Etherscan verification (optional)
ETHERSCAN_API_KEY=

# Coolify production environment. Values are placeholders only.
# App: plundrix-game-production [EU]
NODE_ENV=production
NOINDEX=false
PORT=8080
VITE_CONTRACT_ADDRESS=
VITE_RPC_URL=https://example.com
AGENT_ENABLE_SESSION_RELAY=false
AGENT_SESSION_RELAY_PRIVATE_KEY=0x...
