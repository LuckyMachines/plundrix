# Foundry deploy
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
PRIVATE_KEY=0x...
ANVIL_RPC_URL=http://127.0.0.1:18645 # set to your active anvil port when non-default
# Local app env is written automatically by `npm run deploy:local`

# Etherscan verification (optional)
ETHERSCAN_API_KEY=

# Coolify production environment. Values are placeholders only.
# App: plundrix-game-production [EU]
NODE_ENV=production
NOINDEX=false
PORT=8080
VITE_AGENT_SERVICE_URL=

# Managed game service. Keep every secret server-side: never use a VITE_ prefix.
AGENT_ENABLE_MANAGED_PLAY=true
AGENT_ENABLE_RAW_API=false
AGENT_ALLOW_ORIGIN=https://game.plundrix.com
AGENT_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AGENT_MANAGED_CHAIN_ID=11155111
AGENT_CONTRACT_ADDRESS=
AGENT_WORKSHOP_ADDRESS=
AGENT_SPONSOR_PRIVATE_KEY=0x...
AGENT_CUSTODY_SECRET=
AGENT_SESSION_SECRET=

# Sponsorship guardrails (wei). Defaults are deliberately small.
AGENT_MAX_GAS_PRICE_WEI=2000000000
AGENT_MAX_TRANSACTION_WEI=500000000000000
AGENT_DAILY_BUDGET_WEI=10000000000000000
AGENT_SPONSOR_RESERVE_WEI=20000000000000000
AGENT_MIN_PLAYER_FUNDING_WEI=100000000000000
AGENT_MAX_PLAYER_BALANCE_WEI=1000000000000000
AGENT_FUNDING_MULTIPLIER=3
AGENT_SESSION_MAX_AGE_SECONDS=15552000
AGENT_SPONSOR_BUDGET_PATH=agent-service/data/sponsor-budget.json
AGENT_MANAGED_OPERATIONS_PATH=agent-service/data/managed-operations.json
AGENT_WEEKLY_VAULT_SCORES_PATH=agent-service/data/weekly-vault-scores.json
AGENT_COMPETITION_SNAPSHOT_PATH=agent-service/data/competition-index.json
AGENT_COMPETITION_CACHE_MS=60000
AGENT_COMPETITION_STALE_MS=900000
PLUNDRIX_HEALTH_MAX_LATENCY_MS=5000
AGENT_MANAGED_SWEEP_INTERVAL_MS=15000

# Legacy signing routes remain off in the public service.
AGENT_ENABLE_SESSION_RELAY=false
