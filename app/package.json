    "design:decision": "node scripts/record-design-decision.mjs",
    "design:backlog": "node scripts/design-control-tower.mjs --backlog --csv",
    "cohesion:check": "node scripts/cohesion-check.mjs",
    "fun:check": "node scripts/fun-check.mjs",
    "test:autopilot": "node scripts/test-balance-autopilot.mjs",
    "test:art": "node scripts/test-art-pipeline.mjs",
    "test:inventory": "node scripts/test-gadget-inventory.mjs",
    "workshop:contact-sheet": "node scripts/build-workshop-contact-sheet.mjs",
    "test:replay": "node scripts/test-replay-director.mjs",
    "test:fun": "node scripts/test-fun-systems.mjs",
    "test:oracle": "node scripts/test-live-ops-oracle.mjs",
    "test:launch": "node scripts/test-launch-copilot.mjs",
    "test:ghosts": "node scripts/test-player-telemetry-ghosts.mjs",
    "test:mutations": "node scripts/test-rule-mutation-time-machine.mjs",
    "test:playtest": "node scripts/test-playtest-coach.mjs",
    "test:design": "node scripts/test-design-control-tower.mjs",
    "test:telemetry": "node scripts/test-live-telemetry.mjs",
    "test:improvement": "node scripts/test-improvement-system.mjs",
    "style:check": "node scripts/style-contract.mjs",
    "style:fix": "node scripts/style-contract.mjs --fix",
    "test:ui-system": "npm run style:check && node scripts/test-ui-review-system.mjs",
    "ui:review": "node scripts/ui-review.mjs",
    "ui:approve": "node scripts/ui-review.mjs --approve",
    "test:e2e": "playwright test",
    "test:seo": "node scripts/test-seo-build.mjs",
    "test:e2e:ui": "playwright test --ui",
    "verify:sepolia:read": "node scripts/verify-sepolia-readonly.mjs",
    "verify:sepolia:funded-ui": "node scripts/capture-sepolia-funded.mjs",
    "start": "node scripts/serve-dist.mjs"
