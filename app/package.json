{
  "name": "plundrix-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run art:validate",
    "build": "vite build && node scripts/postbuild-seo-pages.mjs",
    "build:social": "node scripts/art-pipeline.mjs build --family social-source",
    "build:trailers": "node scripts/build-social-trailers.mjs",
    "improve": "node scripts/improve.mjs",
    "improve:verify": "node scripts/improve.mjs --verify",
    "improve:release": "node scripts/improve.mjs --release --keep-going",
    "art:validate": "node scripts/art-pipeline.mjs validate",
    "art:generate": "node scripts/art-pipeline.mjs generate",
    "art:generate-batch": "node scripts/art-pipeline.mjs generate-batch",
    "art:promote": "node scripts/art-pipeline.mjs promote",
    "art:compose": "node scripts/art-pipeline.mjs compose",
    "art:prompts": "node scripts/art-pipeline.mjs prompts",
    "art:build": "node scripts/art-pipeline.mjs build",
    "art:inventory": "node scripts/art-pipeline.mjs inventory",
    "art:all": "node scripts/art-pipeline.mjs all",
    "preview": "vite preview",
    "simulate": "node scripts/simulate-game.mjs",
    "simulate:auto-balance": "node scripts/auto-balance.mjs",
    "balance:matrix": "node scripts/balance-matrix.mjs",
    "replay:direct": "node scripts/direct-replay.mjs",
    "replay:capture": "node scripts/capture-replay.mjs",
    "ops:oracle": "node scripts/live-ops-oracle.mjs",
    "launch:copilot": "node scripts/launch-copilot.mjs",
    "launch:check-config": "node scripts/launch-check-config.mjs",
    "launch:check-agent": "node scripts/launch-check-agent.mjs",
    "launch:rehearse-contracts": "node scripts/launch-rehearse-contracts.mjs",
    "ghosts:run": "node scripts/player-telemetry-ghosts.mjs",
    "ghosts:report": "node scripts/player-telemetry-ghosts.mjs --report --markdown",
    "ghosts:tool-hoarder": "node scripts/tool-hoarder-validation.mjs",
    "mutate:rules": "node scripts/rule-mutation-time-machine.mjs",
    "mutate:matrix": "node scripts/rule-mutation-time-machine.mjs --matrix",
