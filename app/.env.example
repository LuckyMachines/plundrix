VITE_CONTRACT_ADDRESS=0x... # auto-managed in app/.env.local by `npm run deploy:local`
VITE_WORKSHOP_ADDRESS=0x... # auto-managed in app/.env.local by `npm run deploy:local`
VITE_WALLETCONNECT_PROJECT_ID=
VITE_RPC_URL=
VITE_FOUNDRY_RPC_URL=http://127.0.0.1:18645
VITE_ENABLE_STAKES=false
VITE_ENABLE_SESSION_KEYS=false
VITE_SESSION_RELAY_URL=
