{
  "schemaVersion": 1,
  "name": "Plundrix canonical UI review",
  "description": "A deliberately small visual contract for the player-facing states that carry the product.",
  "viewports": {
    "desktop": { "width": 1440, "height": 1000 },
    "mobile": { "width": 390, "height": 844 }
  },
  "defaults": {
    "viewports": ["desktop", "mobile"],
    "maxDiffPixelRatio": 0.002,
    "pixelThreshold": 0.2,
    "maskSelectors": [".alive-timeout-dial"],
    "rules": [
      "Capture the same seeded fixture and viewport every time.",
      "Judge composition and hierarchy before decorative detail.",
      "Never approve a changed baseline without a written reason.",
      "Treat accessibility, overflow, missing images, and unstable state as visual failures."
    ]
  },
  "surfaces": [
